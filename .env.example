# Webetu Credentials & Test Configuration
# Copy this file to .env and fill in your details:
# cp .env.example .env

WEBETU_USERNAME=your_student_id
WEBETU_PASSWORD=your_password

# Optional: Default meal depots
# Example depot IDs:
# DEPOT_RESIDENCE: e.g. 101 (مطعم الإقامة الجامعية)
# DEPOT_CENTRAL: e.g. 202 (المطعم الجامعي المركزي)
DEPOT_RESIDENCE=101
DEPOT_CENTRAL=202
